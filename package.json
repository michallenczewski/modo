{
  "name": "modo",
  "productName": "Modo",
  "version": "0.4.2",
  "description": "Lekki szkicownik brył architektonicznych",
  "author": "Michał Lenczewski",
  "license": "GPL-3.0-or-later",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "web": "node scripts/serve-web.js",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "pl.lenczewski.modo",
    "productName": "Modo",
    "artifactName": "Modo-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**"
    ],
    "directories": {
      "output": "dist"
    },
    "fileAssociations": [
      {
        "ext": "modo",
        "name": "Szkic Modo",
        "description": "Szkic Modo",
        "mimeType": "application/x-modo",
        "role": "Editor",
        "rank": "Owner",
        "icon": "modo-file"
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "extendInfo": {
        "CFBundleDisplayName": "Modo",
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "pl.lenczewski.modo.szkic",
            "UTTypeDescription": "Szkic Modo",
            "UTTypeConformsTo": [
              "public.data",
              "public.content"
            ],
            "UTTypeIconFile": "modo-file.icns",
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "modo"
              ],
              "public.mime-type": [
                "application/x-modo"
              ]
            }
          }
        ],
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Szkic Modo",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": [
              "pl.lenczewski.modo.szkic"
            ],
            "CFBundleTypeExtensions": [
              "modo"
            ],
            "CFBundleTypeIconFile": "modo-file.icns"
          }
        ]
      }
    },
    "dmg": {
      "title": "Modo ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon-win.png",
      "executableName": "Modo"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Modo"
    },
    "afterSign": "build/adhoc.js"
  }
}
